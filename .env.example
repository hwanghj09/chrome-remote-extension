# Set a unique key in Cloudtype's secret environment variables.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=REPLACE_WITH_A_RANDOM_32_BYTE_SECRET
# Use a Cloudtype persistent volume path if available; ephemeral storage is reset on redeploy.
DATABASE_PATH=data/devices.db
# Only web hosts on this list can be opened using remote navigation actions.
ALLOWED_NAV_HOSTS=example.com,port-0-chrome-remote-extension-iad5e2alq4tgcen.sel4.cloudtype.app
